# Site Car Tracker - settings for docker compose.
# Copy this file to ".env" in the same folder (cp .env.example .env), then edit ".env".
# ".env" is ignored by git on purpose: it holds the real password. Never commit it.
# Placeholders: example.com is not a real domain, CHANGE_ME must be replaced.

# ---------------------------------------------------------------- address
# Mode A (Caddy owns ports 80/443): the sub-domain you created, e.g. tracker.example.com.
#   Caddy gets a free HTTPS certificate for it automatically.
#   The DNS A record must already point to this server and ports 80/443 must be reachable.
# First local test without a domain:  SITE_ADDRESS=:80   then open http://localhost
# Mode B (existing proxy): docker-compose.existing-proxy.yml forces ":80" inside the container,
#   so the value here is ignored there; keep your domain here anyway for reference.
SITE_ADDRESS=tracker.example.com

# Mode B only: the port on 127.0.0.1 where your existing proxy finds the app.
APP_PORT=8080

# --------------------------------------------------------------- database
# One long random password, letters and digits only (avoids quoting problems).
# Create one with:  openssl rand -hex 24
# Used by both PostgreSQL and Traccar. Changing it later does NOT change an existing database
# (see README "Troubleshooting"); choose it before the first `docker compose up`.
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# ---------------------------------------------------------------- traccar
# Exact image tag. 6.16.0-alpine was current on 2026-09-27 (https://www.traccar.org/docker/).
# To update: change this, then `docker compose pull && docker compose up -d`.
TRACCAR_TAG=6.16.0-alpine

# Java heap limit for Traccar. 512 MB is enough for 2 cars on a small server.
JAVA_OPTS=-Xmx512m
# Hard memory cap for the Traccar container (heap + JVM overhead). Keep it above the heap.
TRACCAR_MEM_LIMIT=1g

# -------------------------------------------------------- tracker ports
# Who may connect to each tracker port. 0.0.0.0 = the internet (needed for a real tracker),
# 127.0.0.1 = nobody from outside (closed). Open ONLY what you use.
# Docker ignores ufw, so these settings are the real switch, not the firewall.
# 5055: phone app test (Traccar Client). Close it again once a real tracker works.
OSMAND_BIND=0.0.0.0
# 5023: GT06 family trackers.
GT06_BIND=127.0.0.1
# 5027: Teltonika trackers.
TELTONIKA_BIND=127.0.0.1
# 5004: Queclink GL/GV series.
QUECLINK_BIND=127.0.0.1

# ------------------------------------- app build settings (baked in at build)
# Changing these needs a rebuild:  docker compose up -d --build
# Where the app gets its data. "traccar" for the real server, "mock" for demo data.
VITE_DATA_SOURCE=traccar
# Time zone used to DISPLAY times (Traccar itself stores UTC). IANA name.
VITE_TIMEZONE=Asia/Makassar
# Exact name of the geofence drawn around the work site in Traccar.
VITE_SITE_GEOFENCE_NAME=Site
