# Which data module the app uses: "mock" (built-in demo data, no login) or "traccar" (a real Traccar server).
VITE_DATA_SOURCE=mock
# IANA time zone used to display all times. Traccar stores UTC.
VITE_TIMEZONE=Asia/Makassar

# --- Only used when VITE_DATA_SOURCE=traccar ---------------------------------------------------------------------
# Name of the Traccar geofence that is the work-site zone (case-insensitive). Every other geofence is a plain place.
VITE_SITE_GEOFENCE_NAME=Site
# Where the app finds Traccar. Leave empty in production: the reverse proxy serves the app and /api on one origin.
# VITE_TRACCAR_URL=
# Development only: `npm run dev` proxies /api (and the WebSocket) to this server, so no CORS is needed.
# Use the local fake (`npm run fake-traccar`, sign in demo@example.com / demo) or a remote Traccar:
# VITE_TRACCAR_DEV_URL=http://localhost:8082
# The login is typed on the sign-in screen. Never put a password or token in this file.
